# Copier en .env puis remplir
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-5.4-mini
# Jeton partagé entre l'app mobile et l'API (ex. `openssl rand -hex 24`)
APP_TOKEN=change-me
# Port exposé sur la machine hôte
API_PORT=8000
# Origines autorisées (CORS) pour le rendu web Expo, séparées par des virgules
CORS_ORIGINS=
